{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "packageRules": [
    {
      "description": "Disable major updates (security majors still come through vulnerabilityAlerts)",
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "0.x minor bumps are breaking under semver - review manually",
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "addLabels": ["security"]
  }
}
